{
    "build": {
      "backend": {
        "root": "backend",
        "build": "pip install -r requirements.txt",
        "start": "uvicorn app.main:app --host 0.0.0.0 --port $PORT"
      },
      "frontend": {
        "root": "frontend",
        "build": "npm install && npm run build",
        "start": "npm run start"
      }
    }
  }
  